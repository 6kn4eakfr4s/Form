{
  "name": "personalharness",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format . --write",
    "check": "biome check . --error-on-warnings",
    "check:fix": "biome check . --write --error-on-warnings"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/6kn4eakfr4s/Personal-Harness.git"
  },
  "keywords": [],
  "type": "module",
  "bugs": {
    "url": "https://github.com/6kn4eakfr4s/Personal-Harness/issues"
  },
  "homepage": "https://github.com/6kn4eakfr4s/Personal-Harness#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@12.0.2"
}
